# ── Database ────────────────────────────────────────────────────────────────
# Runtime connection. On Vercel use your provider's POOLED URL (Neon "-pooler" host,
# Supabase port 6543 with ?pgbouncer=true).
DATABASE_URL="postgresql://nokhba:nokhba@localhost:5432/nokhba?schema=public"
# Direct (non-pooled) connection — used only by `prisma migrate`. Locally: same as above.
DIRECT_URL="postgresql://nokhba:nokhba@localhost:5432/nokhba?schema=public"

# ── Security ────────────────────────────────────────────────────────────────
# Protects the whole app with HTTP Basic auth (username: admin).
# REQUIRED in production. Leave empty only for local development.
ADMIN_PASSWORD=""

# ── Locale ──────────────────────────────────────────────────────────────────
# Timezone used for "today" / billing month calculations
APP_TIMEZONE="Africa/Cairo"
